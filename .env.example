# Local development example.
# Never commit real secrets. Production values belong in Cloudflare Pages settings.

# Contact and newsletter email
SENDGRID_API_KEY=replace_me
SENDGRID_FROM_EMAIL=info@thecontractingpreacher.com

# GoHighLevel (GHL) CRM push integration. Every form-submission endpoint
# (contact, booking, newsletter, intake, command-center master intake) will
# best-effort push the submission into GHL as a Contact once both of these
# are set. Use a Private Integration Token (PIT) scoped to the location,
# created under Settings -> Private Integrations inside that GHL
# sub-account, with scopes: contacts.readonly, contacts.write,
# locations/customFields.readonly, locations/customFields.write,
# locations/tags.readonly, locations/tags.write. Custom fields/tags
# themselves are provisioned once via scripts/ghl_setup_fields.py -- do not
# hand-create fields in the GHL UI with different keys or the mapping in
# functions/_shared/ghl.ts call sites will silently stop matching.
GHL_PIT=replace_me
GHL_LOCATION_ID=replace_me

# Admin and client portal gates
ADMIN_ACCESS_CODE=mcknight1
PORTAL_ACCESS_CODE=replace_me

# Federal opportunity APIs
SAM_API_KEY=replace_me
SAMS_API_KEY=replace_me
SIMPLER_GRANTS_API_KEY=replace_me
DATA_GOV_API_KEY=replace_me
OPEN_CORPORATES_API_KEY=replace_me
OPENSANCTIONS_API_KEY=replace_me

# Case law / bid protest and dataset catalog enrichment
COURTLISTENER_API_KEY=replace_me

# Optional OpenAI fallback. Cloudflare Workers AI binding is preferred in production.
OPENAI_API_KEY=replace_me
OPENAI_MODEL=gpt-4o-mini
AGENT_MODEL=@cf/meta/llama-3.1-8b-instruct
